#!/usr/bin/env bash
# pre-commit — Tier 1 enforcement floor (covers EVERY agent + human).
# Enabled per-clone with: git config core.hooksPath .githooks  (see .ai/README.md SETUP)
#
# Runs two fast, deterministic gates. NO tests here (they belong in CI, ci.yml) —
# pre-commit must stay quick so it does not tempt anyone into --no-verify.
#   1. Secret scan of the staged change (single source: .ai/bin/check-secrets.sh).
#   2. If any */tasks.md is staged, require an Evidence: block in the staged content
#      (presence check only — the real typecheck+test gate runs in CI / task-gate).
# Any non-zero exit blocks the commit.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
BIN="$REPO_ROOT/.ai/bin"

LIBGUARD="$BIN/lib-guard.sh"
[ -r "$LIBGUARD" ] || { echo "Blocked: missing guard fragment $LIBGUARD — cannot verify guard patterns" >&2; exit 2; }
# shellcheck source=../.ai/bin/lib-guard.sh
. "$LIBGUARD"

# 1. Secret scan (staged diff). check-secrets.sh exits non-zero when a secret is found.
"$BIN/check-secrets.sh"

# 2. Per-task Evidence check for staged tasks.md files. Delegates to the shared engine
#    (.ai/bin/check-evidence.sh --added-only, REQ-1.2) so this policy cannot half-land
#    relative to gate-task.sh's --strict mode. PRESENCE-ONLY, same as always: pre-existing
#    [x] tasks are NOT re-checked (only lines this diff adds), and an edit that adds no new
#    [x] line cannot be blocked, so unrelated edits to a tasks.md don't cause false-blocks.
STAGED_TASKS=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)tasks\.md$' || true)
if [ -n "$STAGED_TASKS" ]; then
  EVIDENCE_ENGINE="$BIN/check-evidence.sh"
  [ -x "$EVIDENCE_ENGINE" ] || { echo "Blocked: missing/non-executable Evidence engine at $EVIDENCE_ENGINE" >&2; exit 2; }

  missing=()
  while IFS= read -r f; do
    [ -z "$f" ] && continue

    # Added (diff '+') lines for this file that mark a task done. Strip the leading '+'
    # (but not '+++ ' header lines) so they can be compared against the staged file body.
    added_done=$(git diff --cached --unified=0 -- "$f" 2>/dev/null \
      | grep -E '^\+' | grep -vE '^\+\+\+' \
      | sed 's/^+//' \
      | grep -iE -- "$CB_DONE" || true)
    [ -z "$added_done" ] && continue

    # Staged (index) version of the whole file — the source of truth for task scope.
    staged_content=$(git show ":$f" 2>/dev/null || true)
    [ -z "$staged_content" ] && continue

    ADDED_TMP="$(mktemp)"
    printf '%s\n' "$added_done" > "$ADDED_TMP"
    if out=$(printf '%s\n' "$staged_content" | "$EVIDENCE_ENGINE" --added-only "$ADDED_TMP"); then
      : # pass
    else
      rc=$?
      case $rc in
        1) missing+=("$f") ;;
        *) rm -f "$ADDED_TMP"; echo "Blocked: Evidence engine error (exit $rc) at $EVIDENCE_ENGINE" >&2; exit 2 ;;
      esac
    fi
    rm -f "$ADDED_TMP"
  done <<<"$STAGED_TASKS"

  if [ "${#missing[@]}" -gt 0 ]; then
    echo "Blocked: a newly-marked [x] task has no 'Evidence:' line in its own block:" >&2
    for f in "${missing[@]}"; do echo "  - $f" >&2; done
    echo "Add an Evidence: block (test result + viewports 375/768/1440 or n/a + deviations) under that task before committing." >&2
    exit 1
  fi
fi

exit 0
