{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          { "type": "command", "command": ".codex/hooks/guard.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|Bash|Write|Edit)$",
        "hooks": [
          { "type": "command", "command": ".codex/hooks/task-gate.sh", "timeout": 120 }
        ]
      }
    ]
  }
}
