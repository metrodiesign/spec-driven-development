{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.platform/schemas/pr-judge.schema.json",
  "title": "PR Evidence Judge Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["snapshot", "findings", "actionRequests"],
  "properties": {
    "snapshot": { "$ref": "pr-review.schema.json#/$defs/snapshot" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["canonicalFindingKey", "sourceFindingIds", "classification", "severity", "evidenceRefs", "rationale"],
        "properties": {
          "canonicalFindingKey": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$" },
          "sourceFindingIds": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^C[0-3]:" } },
          "classification": { "enum": ["VERIFIED", "PARTIALLY_VERIFIED", "UNVERIFIED", "FALSE_POSITIVE"] },
          "severity": { "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
          "evidenceRefs": { "type": "array", "items": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } },
          "rationale": { "type": "string", "minLength": 1 }
        }
      }
    },
    "actionRequests": { "type": "array", "maxItems": 0 }
  }
}
